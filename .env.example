# =====================================================
# AchachAI - Variables de entorno
# Copia este archivo a .env y rellena con tus credenciales
# NUNCA commitear .env al repo
# =====================================================

# --- Azure OpenAI (agente GPT-4o) ---
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-3-large

# --- Azure Machine Learning ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-achachai
AZURE_ML_WORKSPACE=mlw-achachai
AZURE_ML_REGION=eastus2

# Endpoint del modelo desplegado
AZURE_ML_ENDPOINT_URL=https://<endpoint>.eastus2.inference.ml.azure.com/score
AZURE_ML_ENDPOINT_KEY=
AZURE_ML_DEPLOYMENT_NAME=fraud-xgb-v1

# --- App / API ---
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Datos ---
DATA_RAW_PATH=data/raw/Car_Insurance_Fraud_Detection_Dataset.csv
DATA_PROCESSED_PATH=data/processed/
DATA_SYNTHETIC_PATH=data/synthetic/

# --- Thresholds del score ---
SCORE_VERDE_MAX=40
SCORE_AMARILLO_MAX=75
# 76-100 = ROJO
