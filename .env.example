# ================================================================
# AchachAI — Variables de entorno (PLANTILLA)
# ----------------------------------------------------------------
# COMO USARLO:
#   1) Copia este archivo:    cp .env.example .env
#   2) Reemplaza CADA <placeholder> con tus credenciales reales
#      de Azure (el equipo recibio un .env con valores rellenos
#      por canal privado; este archivo solo es la PLANTILLA).
#   3) NUNCA commitees el .env real al repo (esta en .gitignore).
#
# SIN ESTAS CREDENCIALES LA APP NO ARRANCA:
#   - AZURE_OPENAI_API_KEY        -> chat /chat, vision /evaluar-completo
#   - AZURE_OPENAI_ENDPOINT
#   - AZURE_DOCINTEL_KEY          -> /evaluar-completo (analisis de factura)
#   - AZURE_DOCINTEL_ENDPOINT
# ================================================================


# -----------------------------------------------------------------
# 1) AZURE OPENAI  (gpt-5-mini para chat, gpt-4o para vision)
# -----------------------------------------------------------------
# Crear en  portal.azure.com -> Azure OpenAI -> Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=<tu-api-key-de-azure-openai>
AZURE_OPENAI_API_VERSION=2024-10-21

# Nombres de DEPLOYMENT (no del modelo). Estos los defines vos en
# Azure AI Foundry -> Deployments. Deben existir antes de arrancar.
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-5-mini
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-3-large


# -----------------------------------------------------------------
# 2) AZURE DOCUMENT INTELLIGENCE  (analisis de facturas + parte policial)
# -----------------------------------------------------------------
# Crear en  portal.azure.com -> Document Intelligence -> Keys and Endpoint
# Modelos usados:  prebuilt-invoice  +  prebuilt-read
AZURE_DOCINTEL_ENDPOINT=https://<tu-recurso-docintel>.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=<tu-api-key-de-document-intelligence>


# -----------------------------------------------------------------
# 3) AZURE MACHINE LEARNING  (opcional - solo si usas endpoint remoto)
# -----------------------------------------------------------------
# Si no configuras esto, el sistema usa el modelo local en runs/local/
AZURE_SUBSCRIPTION_ID=<tu-subscription-id>
AZURE_RESOURCE_GROUP=rg-achachai
AZURE_ML_WORKSPACE=mlw-achachai
AZURE_ML_REGION=eastus2

AZURE_ML_ENDPOINT_URL=https://<endpoint>.eastus2.inference.ml.azure.com/score
AZURE_ML_ENDPOINT_KEY=<tu-key-del-endpoint-ml>
AZURE_ML_DEPLOYMENT_NAME=fraud-xgb-v1


# -----------------------------------------------------------------
# 4) APP / API  (defaults locales — normalmente no hace falta tocar)
# -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO


# -----------------------------------------------------------------
# 5) FRONTEND (Next.js)
# -----------------------------------------------------------------
# Esto va en frontend/.env.local (NO aca). Lo dejamos como recordatorio.
# NEXT_PUBLIC_API_URL=http://localhost:8000


# -----------------------------------------------------------------
# 6) DATOS / THRESHOLDS  (defaults — el codigo ya los usa)
# -----------------------------------------------------------------
DATA_RAW_PATH=data/raw/Car_Insurance_Fraud_Detection_Dataset.csv
DATA_PROCESSED_PATH=data/processed/
DATA_SYNTHETIC_PATH=data/synthetic/

SCORE_VERDE_MAX=40
SCORE_AMARILLO_MAX=75
# 76-100 = ROJO
